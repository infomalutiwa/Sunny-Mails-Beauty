rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function studio() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['info.malutiwa@gmail.com'];
    }

    // Alte Terminanfragen (WhatsApp-Weg), bleiben fürs Postfach erhalten
    match /anfragen/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','phone','email','service','when','note','createdAt','status'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 120
        && request.resource.data.status == 'neu'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if studio();
    }

    // Gebuchte Termine (mit Kundendaten): nur das Studio darf lesen
    match /termine/{id} {
      // Öffnungszeiten (Minuten ab Mitternacht). r = Wochentag als Rest der Epoche-Millisekunden:
      // Do 0, Fr 86400000, Mo 345600000, Di 432000000. Muss zu hours in assets/booking-config.js passen.
      function inHours(r, s, e) {
        return (r == 345600000 && s >= 480 && e <= 780)
          || ((r == 432000000 || r == 0) && ((s >= 480 && e <= 780) || (s >= 900 && e <= 1200)))
          || (r == 86400000 && s >= 600 && e <= 960);
      }
      // Termin muss in den Öffnungszeiten liegen, mindestens ca. 2,5 Std. Vorlauf haben und höchstens 60 Tage voraus liegen
      function okTime(d) {
        let ts = timestamp.date(int(d.date[0:4]), int(d.date[5:7]), int(d.date[8:10]));
        return inHours(ts.toMillis() % 604800000, d.start, d.end)
          && ts + duration.value(d.start, 'm') >= request.time + duration.value(150, 'm')
          && ts <= request.time + duration.value(60, 'd');
      }
      function okBooking(d) {
        return d.keys().hasOnly(['name','phone','email','note','services','date','start','end','minutes','price','createdAt','status'])
          && d.name is string && d.name.size() > 0 && d.name.size() < 120
          && d.phone is string && d.phone.size() >= 6 && d.phone.size() < 40
          && d.email is string && d.email.size() < 160
          && d.note is string && d.note.size() < 500
          && d.services is list && d.services.size() > 0 && d.services.size() <= 6
          && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.start is int && d.end is int && d.minutes is int
          && d.start >= 360 && d.end <= 1320 && d.start % 15 == 0
          && d.end - d.start == d.minutes && d.minutes > 0 && d.minutes <= 480
          && d.status == 'gebucht'
          && okTime(d)
          && d.createdAt == request.time
          // Anfang und Ende müssen im selben Schreibvorgang belegt werden
          && existsAfter(/databases/$(database)/documents/slots/$(d.date + '_' + string(d.start)))
          && existsAfter(/databases/$(database)/documents/slots/$(d.date + '_' + string(d.end - 15)));
      }
      allow create: if okBooking(request.resource.data) || studio();
      allow read, update, delete: if studio();
    }

    // Belegte 15-Minuten-Blöcke, ohne Kundendaten. Ein Block kann nur einmal angelegt
    // werden (kein Update erlaubt), dadurch sind Doppelbuchungen ausgeschlossen.
    match /slots/{sid} {
      allow read: if true;
      allow create: if studio() || (
        request.resource.data.keys().hasOnly(['d','m','b'])
        && request.resource.data.m is int && request.resource.data.m % 15 == 0
        && sid == request.resource.data.d + '_' + string(request.resource.data.m)
        && getAfter(/databases/$(database)/documents/termine/$(request.resource.data.b)).data.date == request.resource.data.d
        && request.resource.data.m >= getAfter(/databases/$(database)/documents/termine/$(request.resource.data.b)).data.start
        && request.resource.data.m < getAfter(/databases/$(database)/documents/termine/$(request.resource.data.b)).data.end
      );
      allow delete: if studio();
    }
  }
}
